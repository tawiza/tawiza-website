---
/**
 * BaseLayout · shell commun tawiza.fr V2
 * header + footer + scripts + CSS global partagé.
 * currentPath détermine le lien actif dans la nav.
 */

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  noindex?: boolean;
}

const { title, description, currentPath = '/', noindex = true } = Astro.props;

const navItems = [
  { num: '01', label: 'accueil', href: '/' },
  { num: '02', label: 'analyses', href: '/analyses/' },
  { num: '03', label: 'feuilleton', href: '/articles/paris-velo-2026/' },
  { num: '04', label: 'manifeste', href: '/manifeste/' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---
<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://tawiza.fr${currentPath}`} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
</head>
<body>

<header class="shell">
  <div class="wrap shell-row1">
    <a class="wordmark" href="/">
      <span class="slash">//</span><span>tawiza<span class="tld">.fr</span></span>
    </a>
    <div class="eye-block">
      <svg class="eye-svg eye-mode-C" width="84" height="34" viewBox="0 0 40 16" shape-rendering="crispEdges" role="img" aria-label="3AYNE · l'œil Tawiza">
        <title>3AYNE</title>
        <g class="eye-lashes-top" fill="currentColor">
          <rect x="8" y="0" width="1" height="2"></rect>
          <rect x="14" y="0" width="1" height="2"></rect>
          <rect x="20" y="0" width="1" height="2"></rect>
          <rect x="26" y="0" width="1" height="2"></rect>
          <rect x="32" y="0" width="1" height="2"></rect>
        </g>
        <g class="eye-lid-top" fill="currentColor">
          <rect x="6" y="3" width="1" height="1"></rect>
          <rect x="7" y="2" width="2" height="1"></rect>
          <rect x="9" y="2" width="4" height="1"></rect>
          <rect x="13" y="2" width="4" height="1"></rect>
          <rect x="17" y="2" width="6" height="1"></rect>
          <rect x="23" y="2" width="4" height="1"></rect>
          <rect x="27" y="2" width="4" height="1"></rect>
          <rect x="31" y="2" width="2" height="1"></rect>
          <rect x="33" y="3" width="1" height="1"></rect>
        </g>
        <g class="eye-sclera" fill="var(--bg-deep, #f3ebdd)">
          <rect x="8" y="4" width="24" height="8"></rect>
          <rect x="9" y="3" width="22" height="1"></rect>
          <rect x="9" y="12" width="22" height="1"></rect>
          <rect x="11" y="13" width="18" height="1"></rect>
        </g>
        <g class="eye-iris" fill="var(--ocre, #b45309)">
          <rect x="15" y="4" width="10" height="1"></rect>
          <rect x="14" y="5" width="12" height="1"></rect>
          <rect x="13" y="6" width="14" height="1"></rect>
          <rect x="13" y="7" width="14" height="1"></rect>
          <rect x="13" y="8" width="14" height="1"></rect>
          <rect x="13" y="9" width="14" height="1"></rect>
          <rect x="14" y="10" width="12" height="1"></rect>
          <rect x="15" y="11" width="10" height="1"></rect>
        </g>
        <g class="eye-iris-inner" fill="var(--terre, #C1554D)">
          <rect x="16" y="5" width="8" height="1"></rect>
          <rect x="15" y="6" width="10" height="1"></rect>
          <rect x="15" y="7" width="10" height="1"></rect>
          <rect x="15" y="8" width="10" height="1"></rect>
          <rect x="15" y="9" width="10" height="1"></rect>
          <rect x="16" y="10" width="8" height="1"></rect>
        </g>
        <g class="eye-pupil" fill="var(--ink, #1a1612)">
          <rect x="18" y="6" width="4" height="4"></rect>
          <rect x="18" y="6" width="1" height="1" fill="var(--bg, #faf5ef)"></rect>
        </g>
        <g class="eye-lid-bottom" fill="currentColor">
          <rect x="8" y="13" width="2" height="1"></rect>
          <rect x="10" y="14" width="20" height="1"></rect>
          <rect x="30" y="13" width="2" height="1"></rect>
        </g>
        <g class="eye-blinker" fill="var(--bg-deep, #f3ebdd)">
          <rect class="blink-top" x="8" y="3" width="24" height="10"></rect>
        </g>
      </svg>
      <span class="eye-caption">il regarde · il compte · il doute</span>
    </div>
    <nav class="nav" aria-label="navigation principale">
      {navItems.map((item, i) => (
        <a
          href={item.href}
          class:list={['nav-link', { active: isActive(item.href), sep: i > 0 }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="num">{item.num}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>
    <button id="theme-toggle" class="toggle" aria-label="basculer jour/nuit">
      <span id="theme-label">nuit</span>
    </button>
    <button id="burger-toggle" class="burger" aria-label="ouvrir la navigation" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="16" height="12" viewBox="0 0 16 12" fill="none" aria-hidden="true">
        <rect class="burger-line burger-line-1" x="0" y="0" width="16" height="1.5" fill="currentColor"></rect>
        <rect class="burger-line burger-line-2" x="0" y="5" width="16" height="1.5" fill="currentColor"></rect>
        <rect class="burger-line burger-line-3" x="0" y="10" width="16" height="1.5" fill="currentColor"></rect>
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="nav-mobile" aria-label="navigation mobile" hidden>
    <div class="wrap">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['mobile-link', { active: isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          <span class="num">{item.num}</span>
          <span class="lbl">{item.label}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </nav>
</header>

<slot />

<footer class="footer">
  <div class="wrap footer-top">
    <div class="col brand">
      <div class="wordmark"><span class="slash">//</span>tawiza<span class="tld">.fr</span></div>
      <p class="tagline">bien commun numérique<br />entraide collective · 2026</p>
      <ul class="meta">
        <li>sans tracker, sans cookie, sans annonce</li>
        <li>code ouvert · données publiques</li>
        <li>auto-hébergé via serveur dédié</li>
      </ul>
    </div>
    <div class="col">
      <h3 class="col-title">lire</h3>
      <a class="col-link" href="/analyses/">analyses</a>
      <a class="col-link" href="/articles/paris-velo-2026/">feuilletons</a>
      <a class="col-link" href="/manifeste/">manifeste</a>
    </div>
    <div class="col">
      <h3 class="col-title">projet</h3>
      <a class="col-link" href="/a-propos/">à propos</a>
      <a class="col-link" href="/communs/">communs</a>
      <a class="col-link" href="/contribuer/">contribuer</a>
    </div>
    <div class="col">
      <h3 class="col-title">source</h3>
      <a class="col-link" href="https://github.com/tawiza/tawiza">github</a>
      <a class="col-link" href="/feed.xml">flux rss</a>
      <a class="col-link" href="/architecture/">architecture</a>
    </div>
    <div class="col socials">
      <a class="social" href="mailto:tawiza.v0@gmail.com" aria-label="email">@</a>
      <a class="social" href="https://github.com/tawiza" aria-label="github">gh</a>
      <a class="social" href="/feed.xml" aria-label="rss">rss</a>
    </div>
  </div>
</footer>

<script>
  // Animation œil 3AYNE sur scroll
  const eyes = document.querySelectorAll<SVGElement>('.eye-svg.eye-mode-C');
  if (eyes.length > 0) {
    let lastY = window.scrollY;
    let resetT: number | null = null;
    let finalT: number | null = null;
    let handler: ((e: Event) => void) | null = null;

    const start = () => {
      if (handler) return;
      handler = () => {
        const y = window.scrollY;
        const delta = y - lastY;
        lastY = y;
        if (Math.abs(delta) < 1) return;
        const dir = Math.sign(delta);
        const intensity = Math.min(Math.abs(delta) / 40, 1);
        const x = dir * 2 * intensity;
        eyes.forEach((e) => {
          e.classList.add('scrolling');
          e.classList.remove('returning');
          e.style.setProperty('--pupil-x', x + 'px');
          e.style.setProperty('--pupil-y', '0px');
        });
        if (resetT !== null) clearTimeout(resetT);
        if (finalT !== null) clearTimeout(finalT);
        resetT = window.setTimeout(() => {
          eyes.forEach((e) => {
            e.classList.remove('scrolling');
            e.classList.add('returning');
            e.style.setProperty('--pupil-x', (-dir * 1) + 'px');
          });
          finalT = window.setTimeout(() => {
            eyes.forEach((e) => {
              e.style.setProperty('--pupil-x', '0px');
              e.style.setProperty('--pupil-y', '0px');
              e.classList.remove('returning');
            });
          }, 200);
        }, 400);
      };
      window.addEventListener('scroll', handler, { passive: true });
    };

    const stop = () => {
      if (handler) {
        window.removeEventListener('scroll', handler);
        handler = null;
      }
      if (resetT !== null) { clearTimeout(resetT); resetT = null; }
      if (finalT !== null) { clearTimeout(finalT); finalT = null; }
      eyes.forEach((e) => {
        e.classList.remove('scrolling', 'returning');
        e.style.setProperty('--pupil-x', '0px');
        e.style.setProperty('--pupil-y', '0px');
      });
    };

    const mq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!mq.matches) start();
    mq.addEventListener('change', (e) => { e.matches ? stop() : start(); });
  }

  // Theme toggle + burger mobile
  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');
  const themeLabel = document.getElementById('theme-label');

  function setTheme(t: string) {
    root.dataset.theme = t;
    if (themeLabel) themeLabel.textContent = t === 'dark' ? 'jour' : 'nuit';
    try { localStorage.setItem('tawiza-theme', t); } catch {}
  }

  try {
    const saved = localStorage.getItem('tawiza-theme');
    if (saved === 'dark' || saved === 'light') setTheme(saved);
  } catch {}

  const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
  if (themeLabel) themeLabel.textContent = current === 'dark' ? 'jour' : 'nuit';
  themeBtn?.addEventListener('click', () => {
    const t = root.dataset.theme === 'dark' ? 'dark' : 'light';
    setTheme(t === 'dark' ? 'light' : 'dark');
  });

  const burger = document.getElementById('burger-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  function setBurger(open: boolean) {
    if (!burger || !mobileNav) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'fermer la navigation' : 'ouvrir la navigation');
    if (open) {
      mobileNav.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    } else {
      mobileNav.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }
  }

  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    setBurger(!open);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      setBurger(false);
      burger.focus();
    }
  });

  mobileNav?.querySelectorAll('.mobile-link').forEach((l) => {
    l.addEventListener('click', () => setBurger(false));
  });
</script>

</body>
</html>

